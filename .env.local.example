# ── Supabase ──────────────────────────────────────────────────────────────────
# Find these in your Supabase project → Settings → API

# Project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co

# Anon / public key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Service-role key — bypasses Row Level Security. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ── Google Gemini ──────────────────────────────────────────────────────────────
# https://aistudio.google.com/app/apikey
# Server-side only — NEVER expose to the client.
GEMINI_API_KEY=<your-gemini-api-key>

# Optional — overrides the default Gemini model used for AI explanations and
# transcript translation. Falls back to gemini-1.5-flash if unset.
GEMINI_MODEL=gemini-1.5-flash

# ── Upstash Redis (rate limiting) ───────────────────────────────────────────────
# https://console.upstash.com — create a free Redis database, then copy the
# REST URL/token from its "REST API" tab. Server-side only.
# If unset, rate limiting is disabled (fails open) rather than blocking requests.
UPSTASH_REDIS_REST_URL=<your-upstash-redis-rest-url>
UPSTASH_REDIS_REST_TOKEN=<your-upstash-redis-rest-token>

# ── Azure AI Speech (Shadowing "True Evaluation") ───────────────────────────────
# https://portal.azure.com — create a free "Speech" resource (F0 pricing
# tier: 5 audio-hours/month, no cost). Copy the key and region from its
# "Keys and Endpoint" page. Server-side only — never exposed to the client.
# If unset, the True Evaluation section stays hidden entirely (Word Match
# still works) rather than showing a nonfunctional button.
AZURE_SPEECH_KEY=<your-azure-speech-key>
AZURE_SPEECH_REGION=<e.g. eastus>

# Optional — overrides the monthly evaluation budget (in seconds of audio)
# tracked against Upstash Redis. Defaults to 18000 (5 hours), matching the
# Azure F0 free tier. Requires Upstash to be configured above; unenforced
# otherwise.
AZURE_SPEECH_MONTHLY_LIMIT_SEC=18000

# ── Azure AI Speech (Vocabulary pronunciation — Text to Speech) ────────────────
# Reuses the same AZURE_SPEECH_KEY/AZURE_SPEECH_REGION resource above — F0
# Speech resources meter STT and TTS as separate pools on the same resource,
# so no separate Azure resource is needed. Confirm in the Azure Portal
# (Overview → Pricing tier) that the deployed resource is actually still on
# F0 before relying on its free-tier limits (see "Vocabulary Audio Audit and
# Azure TTS Plan.md" §8/§11 Phase 0) — this comment documents intent, not
# guaranteed current Portal state. If unset, the pronunciation button falls
# back to dictionary-only audio (POST /api/vocabulary/pronounce returns
# TTS_NOT_CONFIGURED for anything that would otherwise need synthesis).

# Optional — conservative monthly character budget for on-demand
# synthesis, tracked via Upstash Redis (same mechanism as
# AZURE_KEY_PHRASE_MONTHLY_RECORD_BUDGET). NOT an authoritative mirror of
# Azure Portal's own usage — defaults comfortably under the F0 free tier's
# 500,000 characters/month neural-voice allowance.
AZURE_TTS_MONTHLY_CHAR_BUDGET=400000

# Optional — conservative shared (not per-IP) requests-per-minute ceiling for
# synthesis calls, tracked via Upstash Redis. Kept under Azure F0's
# unadjustable 20-transactions/60s real-time TTS rate limit to leave
# headroom. Defaults to 15.
AZURE_TTS_RPM_LIMIT=15

# ── Azure Translator (vocabulary word/phrase/sentence lookup) ──────────────────
# https://portal.azure.com — create a free "Translator" resource (F0 pricing
# tier: 2M characters/month, no cost). Copy the key and region from its
# "Keys and Endpoint" page. Server-side only — never exposed to the client.
# Used only for vocabulary popover translation (/api/vocabulary/preview and
# /api/vocabulary save); transcript translation is unaffected and does not
# use Azure.
AZURE_TRANSLATOR_KEY=<your-azure-translator-key>
AZURE_TRANSLATOR_REGION=<e.g. eastus>
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# ── Azure AI Language (vocabulary highlight topic-phrase enrichment) ───────────
# https://portal.azure.com — create a free "Language" resource (F0 pricing
# tier: 5,000 text records/month, shared across several Language features on
# the same resource). Copy the key and endpoint from "Keys and Endpoint".
# Server-side only. Optional — the deterministic local pipeline (winkNLP/
# EFLLex/SUBTLEX/WordNet) is fully functional without this; if unset, Azure
# enrichment is skipped and local-only highlights are still returned/cached.
AZURE_LANGUAGE_ENDPOINT=<e.g. https://your-resource.cognitiveservices.azure.com>
AZURE_LANGUAGE_KEY=<your-azure-language-key>
# Pin the current stable Key Phrase Extraction API version — confirm the
# real current value at https://learn.microsoft.com/en-us/rest/api/language/
# before enabling; not resolved as of this writing.
AZURE_LANGUAGE_API_VERSION=<confirm-current-stable-version>

# Optional — monthly text-record budget for Key Phrase Extraction, tracked
# via Upstash Redis (same mechanism as GEMINI_RPM_LIMIT/GEMINI_RPD_LIMIT).
# A conservative internal application budget, NOT an authoritative mirror of
# Azure Portal's own usage — defaults comfortably under the shared
# 5,000/month F0 pool.
AZURE_KEY_PHRASE_MONTHLY_RECORD_BUDGET=4000

# Optional — feature flag, defaults to false until measured to materially
# improve phrase coverage.
AZURE_KEY_PHRASE_ENABLED=false

# Optional — surfaces per-candidate debug reasons for local development only.
VOCAB_HIGHLIGHT_DEBUG=false
